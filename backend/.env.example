# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# ⚠️  PRODUCTION: set this to your real frontend URL (e.g. https://power-plan.onrender.com)
#     A wrong value here will break CORS — the backend will reject all browser requests.

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local dev:
MONGO_URI=mongodb://127.0.0.1:27017/power_plan
# Production (MongoDB Atlas):  https://cloud.mongodb.com → Clusters → Connect → Drivers
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/power_plan?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_random_64_hex_chars
JWT_REFRESH_SECRET=change_me_to_different_random_64_hex_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Anthropic (Claude AI) ─────────────────────────────────────────────────────
# 1. Go to https://console.anthropic.com → API Keys → Create Key
# 2. Copy the key (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
PIPELINE_MAX_CONCURRENT=5

# ── Encryption ────────────────────────────────────────────────────────────────
# Used to encrypt user API keys stored in DB (AES-256 requires exactly 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=32_character_random_string_here_

# ── GitHub (for deploying generated apps) ────────────────────────────────────
# 1. Go to https://github.com/settings/tokens/new
# 2. Select scopes: repo, workflow
# 3. Generate token (classic)
GITHUB_TOKEN=ghp_...
GITHUB_ORG=                  # Optional: GitHub org to create repos under (leave blank for personal)

# ── Render (hosting generated apps) ──────────────────────────────────────────
# 1. Go to https://dashboard.render.com → Account Settings → API Keys → Create API Key
# 2. Go to https://dashboard.render.com → Account Settings → copy your Owner ID
RENDER_API_KEY=rnd_...
RENDER_OWNER_ID=usr_...

# ── MongoDB Atlas (for generated apps' databases) ────────────────────────────
# 1. Go to https://cloud.mongodb.com → Organization → Access Manager → API Keys → Create
# 2. Grant "Project Data Access Admin" role
# 3. Go to your Project → Settings → copy the Project ID
# 4. Your cluster hostname is under Clusters → Connect → copy the host (e.g. cluster0.abc12.mongodb.net)
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_HOST=

# ── Cloudinary (image storage for generated apps) ────────────────────────────
# 1. Go to https://cloudinary.com → Sign Up (free tier available)
# 2. Dashboard → API Keys section
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Resend (email notifications) ─────────────────────────────────────────────
# 1. Go to https://resend.com → Sign Up → API Keys → Create API Key
# 2. Verify your sending domain (or use onboarding@resend.dev for testing)
RESEND_API_KEY=re_...
EMAIL_FROM=notifications@yourdomain.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
